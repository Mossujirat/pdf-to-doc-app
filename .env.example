# The secrets of the web service on gmt (docs/DEPLOY.md). Copy to .env in /srv/pdf-to-doc (production)
# or /srv/pdf-to-doc-staging (staging), on gmt only, readable by its owner alone (chmod 600).
# Never commit .env.

# A Tailscale auth key: one-off, pre-approved, not ephemeral, and tagged tag:pdf-prod for
# production or tag:pdf-staging for staging. The node logs in with it once, and keeps its
# identity in its volume after that.
TS_AUTHKEY=

# Production only: the Turnstile widget's own keys, made in Cloudflare's dashboard for
# pdf.taila2e363.ts.net. Staging uses Cloudflare's test keys, and leaves these out.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
