# Only what the image needs. Everything else stays out of the build context,
# including the confidential sample contracts under docs/example_pdf/.
*
!.gitattributes
!pyproject.toml
!uv.lock
!.python-version
!LICENSE
!src/
!tests/
!corpus/
# The deploy's scripts, so that the image's checks type-check them as the repo's do.
!scripts/
**/__pycache__
